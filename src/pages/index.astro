---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Mark from '../components/Mark.astro';
import CodePanel from '../components/CodePanel.astro';
import ComplianceDiagram from '../components/ComplianceDiagram.astro';
import { routes, devnet } from '../data/site';

const properties = [
  { title: 'Final in ~2 seconds', body: 'No reorganisations. A confirmed transaction stays confirmed.' },
  { title: 'Protocol-level controls', body: 'Freeze and verification lists enforced by the chain itself.' },
  { title: 'EVM-compatible', body: 'Solidity, MetaMask and existing tooling, unchanged.' },
  { title: 'Security-first', body: 'Audit partner: Informal Systems.' },
];

const useCases = [
  {
    title: 'Tokenized assets',
    body: 'Issue funds, bonds, credit and other real-world assets as tokens. Your contracts can check an on-chain verification list before any transfer.',
    href: routes.tokenization,
  },
  {
    title: 'Payments and settlement',
    body: 'Move stablecoins and tokenized cash with deterministic finality and predictable fees. Machine-to-machine payments over HTTP (x402) are on the roadmap.',
    href: routes.payments,
  },
  {
    title: 'Enterprise applications',
    body: 'Passkey sign-in, smart-contract accounts and sponsored transactions come as standard, so your users never manage a seed phrase.',
    href: routes.enterprise,
  },
];

const security = [
  'We never fork the core software, so upstream security patches can ship within a 24-hour target.',
  'A circuit breaker can pause specific transaction types without halting the chain.',
  'Rate limits on cross-chain flows cap exposure per window.',
  'Halt-and-recover drills rehearsed on testnet before mainnet.',
];

const rpc = devnet.rpc ?? '[TBD]';
const devnetTs = `<span class="kw">import</span> { createPublicClient, defineChain, http } <span class="kw">from</span> <span class="str">'viem'</span>

<span class="kw">export const</span> devnet = defineChain({
  id: ${devnet.chainId},
  name: <span class="str">'Konstellation ${devnet.name}'</span>,
  nativeCurrency: { name: <span class="str">'${devnet.symbol}'</span>, symbol: <span class="str">'${devnet.symbol}'</span>, decimals: 18 },
  rpcUrls: { default: { http: [<span class="str">'${rpc}'</span>] } },
})

<span class="kw">const</span> client = createPublicClient({ chain: devnet, transport: http() })
<span class="kw">const</span> block = <span class="kw">await</span> client.getBlockNumber()`;
---
<Base
  title="Konstellation — Settlement infrastructure for real-world assets"
  description="Konstellation is an EVM-compatible Layer 1 with compliance controls built into the protocol, final settlement in about two seconds, and security engineering designed for real value from the first block."
>
  <!-- Hero -->
  <section class="hero" aria-label="Introduction">
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="eyebrow">devnet-1 opens to developers <span class="tbd">[TBD]</span></div>
        <h1>Settlement infrastructure for real-world assets.</h1>
        <p class="lead hero-lead">Konstellation is an EVM-compatible Layer 1 with compliance controls built into the protocol, final settlement in about two seconds, and security engineering designed for real value from the first block.</p>
        <div class="btn-row">
          <a href={routes.contact} class="btn btn--primary">Talk to us</a>
          <a href={routes.quickstart} class="btn btn--outline">Start building</a>
        </div>
      </div>
      <div class="hero-mark">
        <svg viewBox="0 0 210 210" role="img" aria-label="Konstellation mark">
          <path fill-rule="evenodd" fill="currentColor" d="M0 105A105 105 0 1 0 210 105A105 105 0 1 0 0 105ZM58.3 105A46.7 46.7 0 1 0 151.7 105A46.7 46.7 0 1 0 58.3 105Z" />
          <circle class="bite-a" cx="26" cy="29" r="47" />
          <circle class="bite-b" cx="181" cy="185" r="47" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Key properties -->
  <section class="props" aria-label="Key properties">
    <div class="container">
      <div class="props-grid">
        {properties.map((p) => (
          <div class="prop">
            <h2 class="prop-title">{p.title}</h2>
            <p class="prop-body">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What you can build -->
  <section class="section section--alt" aria-labelledby="build-h">
    <div class="container build">
      <div class="build-head">
        <h2 id="build-h" class="h2" data-reveal>What you can build.</h2>
        <div class="dot-accent" aria-hidden="true"></div>
      </div>
      <div>
        {useCases.map((u, i) => (
          <div class="case">
            <div class="eyebrow case-num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="case-title">{u.title}</h3>
            <p class="case-body">{u.body}</p>
            <div class="case-link">
              <a href={u.href} class="link" aria-label={`Learn more about ${u.title.toLowerCase()}`}>Learn more<Arrow /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance -->
  <section class="section" aria-labelledby="compliance-h">
    <div class="container">
      <div class="split">
        <div class="compliance-head">
          <div class="eyebrow">Compliance</div>
          <h2 id="compliance-h" class="h2" data-reveal>Controls where they belong: in the protocol.</h2>
        </div>
        <div class="compliance-body">
          <p class="lead">Konstellation maintains two on-chain lists. A verification list that contracts can require before a transfer, and a freeze list the chain enforces on every transaction — native KASH included. Changes are timelocked, recorded on-chain, and subject to governance override.</p>
          <a href={routes.compliance} class="link">How compliance works<Arrow /></a>
        </div>
      </div>
      <div class="compliance-figure">
        <ComplianceDiagram />
      </div>
    </div>
  </section>

  <!-- Security -->
  <section class="section section--alt" aria-labelledby="security-h">
    <div class="container split security">
      <div class="security-head">
        <div class="security-intro">
          <div class="eyebrow">Security</div>
          <h2 id="security-h" class="h2" data-reveal>Operated like financial infrastructure.</h2>
          <a href={routes.security} class="link">Our security approach<Arrow /></a>
        </div>
        <div class="half-disc desk" aria-hidden="true"></div>
      </div>
      <ol class="sec-list">
        {security.map((s, i) => (
          <li>
            <span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="sec-text">{s}</span>
          </li>
        ))}
      </ol>
      <div class="half-disc mob" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Developers -->
  <section class="section" aria-labelledby="dev-h">
    <div class="container split dev">
      <div class="dev-text">
        <div class="eyebrow">Developers</div>
        <h2 id="dev-h" class="h2" data-reveal>Familiar tools. A network ready for you.</h2>
        <p class="lead">Deploy with Foundry or Hardhat, connect with viem or wagmi, and test on devnet with free test KASH.</p>
        <div class="btn-row">
          <a href={routes.developers} class="btn btn--primary">Read the docs</a>
          <a href={routes.faucet} class="btn btn--outline">Get test KASH</a>
        </div>
        <dl class="facts">
          <dt>Chain ID</dt><dd class="mono">{devnet.chainId}</dd>
          <dt>Symbol</dt><dd class="mono">{devnet.symbol}</dd>
          <dt>RPC</dt><dd>{devnet.rpc ? <span class="mono">{devnet.rpc}</span> : <span class="tbd">[TBD]</span>}</dd>
        </dl>
      </div>
      <div class="dev-code">
        <CodePanel id="code-devnet" filename="devnet.ts" html={devnetTs} />
      </div>
    </div>
  </section>

  <!-- Get started (the one contrast section) -->
  <section class="cta inverted" aria-labelledby="cta-h">
    <div class="container cta-grid">
      <div class="cta-text">
        <h2 id="cta-h" class="cta-title" data-reveal>Build the next market on Konstellation.</h2>
        <div class="btn-row">
          <a href={routes.contact} class="btn btn--primary">Talk to us</a>
          <a href={routes.quickstart} class="btn btn--outline">Start building</a>
        </div>
      </div>
      <div class="cta-mark"><Mark size={280} class="cta-mark-svg" /></div>
    </div>
  </section>
</Base>

<style>
  /* ----- Hero ----- */
  .hero { padding-block: 56px; }
  .hero-text { display: flex; flex-direction: column; gap: 24px; }
  h1 {
    font-size: 46px;
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 400;
    text-wrap: balance;
  }
  .hero-lead { max-width: 640px; }
  .hero-mark { display: flex; justify-content: flex-end; margin-top: 56px; color: var(--fg); }
  .hero-mark svg { width: 240px; height: 240px; overflow: hidden; }
  .hero-mark circle { fill: var(--bg); }

  /* ----- Key properties ----- */
  .props { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 8px; }
  .prop { padding: 24px 0; display: flex; flex-direction: column; gap: 6px; }
  .prop + .prop { border-top: 1px solid var(--line); }
  .prop-title { font-size: 19px; line-height: 1.3; letter-spacing: -0.005em; font-weight: 500; text-wrap: balance; }
  .prop-body { font-size: 14px; line-height: 21px; color: var(--muted); text-wrap: pretty; }

  /* ----- What you can build ----- */
  .build { display: flex; flex-direction: column; gap: 48px; }
  .build-head { display: flex; gap: 24px; justify-content: space-between; align-items: flex-start; }
  .dot-accent { width: 72px; height: 72px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
  .case { border-top: 1px solid var(--fg); padding: 24px 0 32px; display: flex; flex-direction: column; gap: 12px; }
  .case-title { font-size: 22px; line-height: 1.25; letter-spacing: -0.01em; font-weight: 500; text-wrap: balance; }
  .case-body { font-size: 16px; line-height: 25px; color: var(--muted); text-wrap: pretty; }
  .case-link { display: flex; }

  /* ----- Compliance ----- */
  .split { display: flex; flex-direction: column; gap: 32px; }
  .compliance-head { display: flex; flex-direction: column; gap: 20px; }
  .compliance-body { display: flex; flex-direction: column; gap: 28px; }
  .compliance-figure { margin-top: 32px; }

  /* ----- Security ----- */
  .security { gap: 40px; }
  .security-head, .security-intro { display: flex; flex-direction: column; gap: 24px; }
  .half-disc { width: 160px; height: 80px; border-radius: 80px 80px 0 0; background: var(--fg); }
  .half-disc.desk { display: none; }
  .sec-list { border-bottom: 1px solid var(--fg); }
  .sec-list li {
    border-top: 1px solid var(--fg);
    padding: 20px 0 24px;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 8px;
  }
  .sec-num { font-family: var(--mono); font-size: 13px; line-height: 28px; color: var(--muted); }
  .sec-text { font-size: 18px; line-height: 26px; letter-spacing: -0.01em; }

  /* ----- Developers ----- */
  .dev { gap: 40px; }
  .dev-text { display: flex; flex-direction: column; gap: 28px; }
  .facts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 8px;
    font-size: 14px;
    line-height: 22px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .facts dt { color: var(--muted); }
  .dev-code { min-width: 0; }

  /* ----- CTA ----- */
  .cta { padding-block: 88px; }
  .cta-text { display: flex; flex-direction: column; gap: 40px; }
  .cta-title { font-size: 38px; line-height: 1.1; letter-spacing: -0.02em; font-weight: 400; text-wrap: balance; }
  .cta-mark { display: flex; justify-content: flex-end; margin-top: 56px; }
  .cta-mark :global(.cta-mark-svg) { width: 140px; height: 140px; }

  /* ----- Desktop ----- */
  @media (min-width: 900px) {
    .hero { padding-block: 112px; }
    .hero-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .hero-text { grid-column: 1 / span 8; gap: 32px; }
    h1 { font-size: clamp(60px, 6.67vw, 96px); line-height: 1; letter-spacing: -0.04em; }
    .hero-mark { grid-column: 9 / span 4; margin-top: 0; align-items: flex-end; }
    .hero-mark svg { width: 100%; max-width: 400px; height: auto; aspect-ratio: 1; }

    .props { padding-block: 0; }
    .props-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .prop { padding: 44px 32px 48px 0; gap: 10px; }
    .prop + .prop { border-top: 0; border-left: 1px solid var(--line); padding-left: 32px; }
    .prop-title { font-size: clamp(19px, 1.53vw, 22px); letter-spacing: -0.01em; }
    .prop-body { font-size: 15px; line-height: 23px; }

    .build { gap: 80px; }
    .dot-accent { width: 136px; height: 136px; }
    .case {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      padding: 36px 0 44px;
    }
    .case-num { grid-column: 1 / span 1; padding-top: 6px; }
    .case-title { grid-column: 2 / span 4; font-size: 28px; line-height: 1.2; letter-spacing: -0.015em; }
    .case-body { grid-column: 6 / span 5; font-size: clamp(18px, 1.46vw, 21px); line-height: 1.52; }
    .case-link { grid-column: 11 / span 2; justify-content: flex-end; padding-top: 4px; }

    .split {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .compliance-head { grid-column: 1 / span 6; }
    .compliance-body { grid-column: 8 / span 5; padding-top: 40px; }
    .compliance-figure { margin-top: 80px; }

    .security-head { grid-column: 1 / span 5; height: 100%; }
    .half-disc.desk { display: block; margin-top: auto; width: 240px; height: 120px; border-radius: 120px 120px 0 0; }
    .half-disc.mob { display: none; }
    .sec-list { grid-column: 7 / span 6; }
    .sec-list li { grid-template-columns: 72px minmax(0, 1fr); padding: 28px 0 32px; }
    .sec-text { font-size: 22px; line-height: 32px; }

    .dev-text { grid-column: 1 / span 5; }
    .dev-code { grid-column: 7 / span 6; }

    .cta { padding-block: 160px; }
    .cta-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .cta-text { grid-column: 1 / span 8; gap: 48px; }
    .cta-title { font-size: clamp(52px, 5.28vw, 76px); line-height: 1.02; letter-spacing: -0.03em; }
    .cta-mark { grid-column: 9 / span 4; margin-top: 0; align-items: center; }
    .cta-mark :global(.cta-mark-svg) { width: 100%; max-width: 280px; height: auto; aspect-ratio: 1; }
  }
</style>
