---
import Mark from './Mark.astro';
import { routes } from '../data/site';
---
<a href={routes.home} class="logo" aria-label="Konstellation home">
  <Mark size={28} class="logo-mark" />
  <span>Konstellation</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    text-decoration: none;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .logo :global(.logo-mark) { width: 26px; height: 26px; }
  @media (min-width: 900px) {
    .logo { font-size: 22px; }
    .logo :global(.logo-mark) { width: 28px; height: 28px; }
  }
</style>
