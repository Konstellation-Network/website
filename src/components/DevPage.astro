---
// Frame for the Developers pages: side nav (desktop), breadcrumb, title and
// intro, the page body, and an optional right rail (slot="rail").
import { developerSideNav, routes } from '../data/site';

interface Props {
  title: string;
  intro: string;
  /** Grid columns the body spans on desktop (7 with a rail, 8 without). */
  span?: 7 | 8;
  /** Show the rail after the body on narrow screens (else it is desktop-only). */
  railOnMobile?: boolean;
}
const { title, intro, span = 7, railOnMobile = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const hasRail = Astro.slots.has('rail');
---
<section class="dev-page" aria-label={title}>
  <div class="container grid">
    <div class="side">
      <nav aria-label="Developers" class="side-nav">
        <div class="eyebrow">Developers</div>
        <ul>
          {developerSideNav.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  class="text-link side-link"
                  aria-current={item.href === path ? 'page' : undefined}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}
                  {item.external && (
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 2h6v6M10 2 2 10" /></svg>
                  )}
                </a>
              ) : (
                <span class="side-link side-off">{item.label} <span class="tbd">[TBD]</span></span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="body" style={`--span: ${span}`}>
      <header class="head">
        <nav aria-label="Breadcrumb" class="crumbs">
          <a href={routes.developers} class="text-link">Developers</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>
        <h1>{title}</h1>
        <p class="intro">{intro}</p>
      </header>
      <slot />
    </div>

    {hasRail && (
      <div class:list={['rail', { 'rail-mobile': railOnMobile }]}>
        <slot name="rail" />
      </div>
    )}
  </div>
</section>

<style>
  .dev-page { padding-block: 40px 80px; }
  .grid { display: flex; flex-direction: column; gap: 40px; }
  .side { display: none; }
  .rail { display: none; }
  .rail-mobile { display: block; }

  .head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .crumbs { display: flex; gap: 8px; font-size: 14px; line-height: 20px; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .crumbs [aria-current] { color: var(--fg); }
  h1 { font-size: 40px; line-height: 1.06; letter-spacing: -0.03em; font-weight: 400; }
  .intro { font-size: 17px; line-height: 26px; color: var(--muted); max-width: 640px; text-wrap: pretty; }

  .side-nav { display: flex; flex-direction: column; gap: 16px; padding-left: 14px; }
  .side-nav ul { display: flex; flex-direction: column; gap: 12px; }
  .side-link { display: flex; align-items: center; gap: 6px; font-size: 15px; line-height: 22px; color: var(--muted); }
  .side-link:hover { color: var(--fg); }
  .side-link[aria-current='page'] {
    color: var(--fg);
    border-left: 2px solid var(--fg);
    padding-left: 12px;
    margin-left: -14px;
  }
  .side-off { gap: 8px; }
  .side-off:hover { color: var(--muted); }

  @media (min-width: 900px) {
    .head { margin-bottom: 56px; }
    .intro { font-size: 21px; line-height: 32px; }
    h1 { font-size: 64px; line-height: 1.02; letter-spacing: -0.035em; }
  }

  @media (min-width: 1100px) {
    .dev-page { padding-block: 72px 136px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: start;
    }
    .side {
      display: block;
      grid-column: 1 / span 2;
      align-self: stretch;
      border-right: 1px solid var(--line);
      padding-top: 8px;
    }
    .body { grid-column: 4 / span var(--span); min-width: 0; }
    .rail { display: block; grid-column: 11 / span 2; position: sticky; top: 24px; }
  }
</style>
