---
import CopyButton from './CopyButton.astro';

// Label / value / Copy rows (network settings, endpoints). A `null` value is
// unpublished: it shows [TBD] and gets no Copy button.
export type Row = { label: string; value: string | number | null };
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---
<div class="rows">
  {rows.map((r) => (
    <div class="row">
      <span class="label">{r.label}</span>
      {r.value === null ? <span class="tbd value">[TBD]</span> : <span class="mono value">{r.value}</span>}
      <div class="act">
        {r.value !== null && (
          <CopyButton value={String(r.value)} label={r.label} />
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .rows { border-top: 1px solid var(--fg); border-bottom: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'label act' 'value act';
    column-gap: 12px;
    row-gap: 4px;
    align-items: center;
    padding: 14px 0;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .label { grid-area: label; font-size: 13px; color: var(--muted); }
  .value { grid-area: value; font-size: 13px; overflow-wrap: anywhere; }
  .value.tbd { font-size: 0.88em; }
  .act { grid-area: act; display: flex; justify-content: flex-end; }


  @media (min-width: 900px) {
    .row {
      grid-template-columns: 200px minmax(0, 1fr) 96px;
      grid-template-areas: 'label value act';
      column-gap: 24px;
      min-height: 64px;
    }
    .label { font-size: 15px; }
    .value { font-size: 15px; }
    .value.tbd { font-size: 13.2px; }
  }
</style>
