---
// The nine Scriipture security gates as a vertical timeline; the last gate
// (attestation) is the outlined terminal step. Descriptions may hold inline
// <code> via the `html` field.
export type Gate = { name: string; html: string };
interface Props {
  gates: Gate[];
}
const { gates } = Astro.props;
const last = gates.length - 1;
---
<ol class="gates" aria-label="Security gates, in order">
  {gates.map((g, i) => (
    <li class:list={['gate', { final: i === last }]}>
      <span class="rail" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
      <div class="box">
        <span class="title">
          <span class="num tbd">{String(i + 1).padStart(2, '0')}</span>
          <span class="name">{g.name}</span>
        </span>
        <span class="desc" set:html={g.html} />
      </div>
    </li>
  ))}
</ol>

<style>
  .gate { position: relative; padding: 0 0 22px 44px; }
  .rail { position: absolute; left: 14px; top: 16px; bottom: -12px; width: 1px; background: var(--fg); }
  .dot {
    position: absolute;
    left: 6px;
    top: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--fg);
  }
  .box { display: flex; flex-direction: column; gap: 4px; }
  .title { display: flex; gap: 12px; align-items: baseline; }
  .num { color: var(--muted); }
  .name { font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; }
  .desc { font-size: 14px; line-height: 21px; color: var(--muted); text-wrap: pretty; }
  .desc :global(code) { font-family: var(--mono); font-size: 0.88em; }

  .final { padding-bottom: 0; }
  .final .rail { display: none; }
  .final .dot { left: 0; top: 2px; width: 28px; height: 28px; border: 0; background: var(--fg); }
  .final .box { margin-top: 4px; padding: 16px 20px; border: 1px solid var(--fg); border-radius: var(--radius); }
  .final .name { font-size: 20px; font-weight: 500; }

  @media (min-width: 900px) {
    .gate { padding: 0 0 26px 48px; }
    .final { padding-bottom: 0; }
    .desc { font-size: 15px; line-height: 23px; }
  }
</style>
