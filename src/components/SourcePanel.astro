---
// Light source-file figure with a filename/language header and line numbers
// (Scriipture examples). Code is pre-highlighted HTML: .kw keywords (ink,
// weight 500), .acc strings and decorators (accent), .cm comments (grey).
interface Props {
  filename: string;
  language: string;
  html: string;
  label?: string;
}
const { filename, language, html, label } = Astro.props;
// One block per source line so its number stays beside it when the line wraps.
// (Highlight spans never cross a line break.)
const lines = html.split('\n');
---
<figure class="src" aria-label={label}>
  <figcaption>
    <span class="file">{filename}</span>
    <span class="lang">{language}</span>
  </figcaption>
  <div class="body">
    <pre><code>{lines.map((line) => <span class="line"><span class="lc" set:html={line || ' '} /></span>)}</code></pre>
  </div>
</figure>

<style>
  .src {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg);
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
  }
  .file { font-size: 13px; font-weight: 500; }
  .lang { font-size: 12px; color: var(--muted); }
  .body {
    display: flex;
    --num-w: 28px;
    --num-gap: 10px;
    padding: 16px 16px 20px 0;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 20px;
  }
  pre {
    margin: 0;
    flex-grow: 1;
    min-width: 0;
    font: inherit;
    color: var(--fg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  code { counter-reset: line; }
  .line {
    display: grid;
    grid-template-columns: var(--num-w) minmax(0, 1fr);
    counter-increment: line;
  }
  .line::before {
    content: counter(line);
    padding-right: var(--num-gap);
    text-align: right;
    color: #8C8C87;
    user-select: none;
  }
  .lc { min-width: 0; }
  pre :global(.kw) { font-weight: 500; }
  pre :global(.acc) { color: var(--accent-text); }
  pre :global(.cm) { color: var(--muted); }

  @media (min-width: 900px) {
    figcaption { padding: 0 20px; }
    .body { padding: 24px 24px 28px 0; font-size: 14px; line-height: 23px; }
    .body { --num-w: 40px; --num-gap: 16px; }
  }
</style>
