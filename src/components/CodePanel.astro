---
// Dark code panel with a filename header and a Copy button. The code is passed
// as pre-highlighted HTML using .kw (keyword) and .str (string) spans.
interface Props {
  id: string;
  filename: string;
  html: string;
}
const { id, filename, html } = Astro.props;
---
<div class="code">
  <div class="head">
    <span class="name">{filename}</span>
    <button type="button" class="copy" data-copy={id} aria-label={`Copy ${filename}`}>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="1" /><path d="M9.5 2.5V1.5H1.5v8h1" /></svg>
      <span data-copy-label aria-live="polite">Copy</span>
    </button>
  </div>
  <pre id={id}><code set:html={html} /></pre>
  <div class="notch" aria-hidden="true"></div>
</div>

<style>
  .code {
    position: relative;
    overflow: hidden;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius);
    color: var(--code-fg);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 48px 0 20px;
    border-bottom: 1px solid var(--code-line);
  }
  .name { font-family: var(--mono); font-size: 12px; color: var(--code-meta); }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    background: transparent;
    color: var(--code-fg);
    border: 1px solid var(--code-line);
    border-radius: var(--radius);
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
    transition: border-color 150ms;
  }
  .copy:hover { border-color: #FFFFFF; }
  pre {
    margin: 0;
    padding: 24px 20px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 22px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  pre :global(.kw) { color: var(--code-kw); font-weight: 500; }
  pre :global(.str) { color: var(--code-str); }
  .notch {
    position: absolute;
    top: -24px;
    right: -24px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg);
  }

  @media (min-width: 900px) {
    .head { padding-right: 56px; }
    pre { padding: 28px 24px; font-size: 14.5px; line-height: 24px; }
    .notch { top: -32px; right: -32px; width: 64px; height: 64px; }
  }
</style>
